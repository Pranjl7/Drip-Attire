<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drip Attire</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/stylesheets/output.css" />
  </head>

  <body class="flex min-h-screen flex-col">
    <%-include('partials/admin-header')%>

    <main class="flex-grow">
      <form
        id="createProductForm"
        enctype="multipart/form-data"
        class="mx-auto mt-[12vh] flex max-h-[67%] w-[70%] flex-col gap-y-2 rounded-lg border bg-white pl-7 pt-2 font-geist sm:w-[60%] md:w-[50%] lg:w-[40%]"
      >
        <label class="mt-1 w-full" for="name">NAME</label>
        <input
          class="h-[35px] w-[35%] rounded-md border px-2 outline-none transition duration-200 focus:border-black focus:ring-1 focus:ring-black/40"
          type="text"
          name="name"
          id="name"
          placeholder="Name"
        />

        <label class="mt-1 w-full" for="description">DESCRIPTION</label>
        <input
          class="h-[35px] w-[95%] rounded-md border px-2 outline-none transition duration-200 focus:border-black focus:ring-1 focus:ring-black/40"
          type="text"
          name="description"
          id="description"
          placeholder="Description"
        />

        <label class="mt-1 w-full" for="price">PRICE</label>
        <input
          class="h-[35px] w-[20%] rounded-md border px-2 outline-none transition duration-200 focus:border-black focus:ring-1 focus:ring-black/40"
          type="number"
          name="price"
          id="price"
          placeholder="Price"
        />

        <div class="mt-1 flex w-[90%] items-center justify-start gap-x-2">
          <p class="">UPLOAD IMAGE</p>
          <label
            for="fileUpload"
            class="cursor-pointer rounded-md bg-blue-600 px-3 py-1 text-[14px] text-white"
          >
            Browse
          </label>
          <input id="fileUpload" type="file" class="hidden" name="image" />
        </div>

        <button
          class="mb-5 mt-3 h-[50px] w-[90%] rounded-full border bg-blue-600 font-bold text-white"
          type="submit"
        >
          CREATE
        </button>
      </form>
    </main>

    <%- include('partials/footer') %>
    <script src="/javascripts/admin-create.js"></script>
  </body>
</html>
