<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drip Attire</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/stylesheets/output.css" />
  </head>

  <body class="flex min-h-screen flex-col font-geist">
    <%-include('partials/user-header')%>
    <div class="flex-grow">
      <!-- Main Loader -->
      <div id="main-loader" class="flex items-center justify-center min-h-[300px]">
        <div class="drip-spinner"></div>
      </div>

      <!-- Account Card -->
      <div
        id="account-card"
        class="relative ml-6 mt-10 hidden w-[21rem] flex-col gap-y-5 overflow-auto rounded-md border p-5 shadow sm:ml-8 sm:w-96"
      >
        <button
          onclick="logout()"
          class="absolute right-2 top-2 rounded-md bg-slate-900 px-4 py-1.5 text-white"
        >
          Logout
        </button>
        <div class="flex items-center gap-x-4">
          <div class="relative size-24 shrink-0 rounded-full bg-slate-100 flex items-center justify-center overflow-hidden">
            <img
              id="image"
              class="absolute inset-0 h-full w-full object-cover"
              alt=""
            />
          </div>
          <p
            id="name"
            class="rounded-md border px-2 py-1 text-xl font-medium min-w-[120px] flex items-center justify-center min-h-[38px]"
          ></p>
        </div>

        <div class="flex flex-col gap-y-2">
          <p class="text-md font-medium flex items-center gap-x-2">
            Emailid : <span id="email" class="text-slate-500"></span>
          </p>
          <p class="text-md font-medium flex items-center gap-x-2">
            Contact no : <span id="contactno" class="text-slate-500"></span>
          </p>
        </div>
      </div>
    </div>
    <%-include('partials/footer')%>
  </body>

  <script>
    (async () => {
      let res = await fetch("/api/user/account");
      let data = await res.json();

      if (res.ok) {
        let user = data.message;
        document.querySelector("#name").textContent = `Hey, ${user.name}`;
        document.querySelector("#email").textContent = `${user.emailid}`;
        document.querySelector("#contactno").textContent = `${user.contactno}`;
        
        let img = document.querySelector("#image");
        if (user.image) {
          img.onload = () => {
            showAccountDetails();
          };
          img.onerror = () => {
            showAccountDetails();
          };
          img.src = user.image;
          if (img.complete) {
            showAccountDetails();
          }
        } else {
          showAccountDetails();
        }
      } else {
        alert(data.message);
        document.querySelector("#main-loader").style.display = "none";
      }
    })();

    function showAccountDetails() {
      const loader = document.querySelector("#main-loader");
      const card = document.querySelector("#account-card");
      if (loader && loader.style.display !== "none") {
        loader.style.display = "none";
        card.classList.remove("hidden");
        card.classList.add("flex");
      }
    }

    async function logout() {
      let confirmed = confirm("Confirm Logout?");
      if (!confirmed) return;

      let res = await fetch("/api/user/logout", {
        method: "DELETE",
      });

      let data = await res.json();
      if (res.ok) {
        window.location.href = "/";
      } else {
        alert(data.message);
      }
    }
  </script>
</html>
