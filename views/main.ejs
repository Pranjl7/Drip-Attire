<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drip Attire</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/stylesheets/output.css" />
  </head>

  <body class="relative font-geist">
    <div
      class="Landing-Page bg- relative h-screen bg-[url('/assets/bg-3.png')] bg-cover bg-center"
    >
      <div class="absolute inset-0 bg-black/20">
        <nav class="mx-auto flex w-[95vw] items-center justify-between pt-4">
          <!-- MENU ICON -->
          <button onclick="showsidebar()" class="ml-1 sm:ml-2 lg:hidden">
            <img class="size-5 sm:size-6" src="/assets/WMenu.svg" alt="" />
          </button>

          <!-- SIDEBAR -->
          <div
            id="sidebar"
            class="absolute left-0 top-0 z-10 hidden h-full w-60 bg-white transition duration-200"
          >
            <button onclick="hidesidebar()" class="absolute right-1.5 top-1.5">
              <img class="size-8" src="/assets/xmark.svg" alt="" />
            </button>
            <div class="flex flex-col gap-y-7 pl-4 pt-12">
              <a href="/collection" class="text-xl">COLLECTION</a>
              <a href="/collection" class="text-xl">NEW ARRIVALS</a>
              <a href="/collection" class="text-xl">TOPWEAR</a>
              <a href="/refundpolicy" class="text-xl">REFUND POLICY</a>
              <a href="/terms-and-condition" class="text-xl"
                >TERMS & CONDITIONS</a
              >
            </div>
          </div>

          <!-- LOGO TEXT -->
          <a
            class="cursor-pointer pl-8 text-3xl font-semibold text-white lg:hidden"
            href="/"
          >
            <p>DRIP ATTIRE.</p>
          </a>

          <div
            class="hidden cursor-pointer items-center justify-around gap-x-5 font-geist text-sm text-white lg:flex"
          >
            <a
              class="transition duration-150 hover:text-[#c5bcbc]"
              href="/collection"
              >COLLECTION</a
            >
            <a
              class="transition duration-150 hover:text-[#c5bcbc]"
              href="/collection"
              >NEW ARRIVALS</a
            >
            <a
              class="transition duration-150 hover:text-[#c5bcbc]"
              href="/collection"
              >TOPWEAR</a
            >
            <a
              class="transition duration-150 hover:text-[#c5bcbc]"
              href="/refundpolicy"
              >REFUND POLICY</a
            >
            <a
              class="transition duration-150 hover:text-[#cfc6c6]"
              href="/terms-and-conditions"
              >TERMS & CONDITIONS</a
            >
            <a class="cursor-pointer pl-8 text-3xl font-semibold" href="/">
              <p>DRIP ATTIRE.</p>
            </a>
          </div>

          <!-- RIGHT SIDE -->
          <div
            class="mr-1 flex items-center justify-around gap-x-5 text-white sm:mr-2"
          >
            <a id="profile" href="#"
              ><img class="size-5 sm:size-6" src="/assets/user.svg" alt=""
            /></a>
            <a href="/cart"
              ><img class="size-5 sm:size-6" src="/assets/cart.svg" alt=""
            /></a>
          </div>
        </nav>

        <a
          class="semibold absolute bottom-8 left-1/2 -translate-x-1/2 font-geist text-[15px] text-white transition duration-150 hover:text-[#969292]"
          href="/collection"
          >Shop now.</a
        >
      </div>
    </div>

    <script>
      (async () => {
        let res = await fetch("/api/user/account");
        let data = res.json();

        if (res.ok) {
          document
            .querySelector("#profile")
            .setAttribute("href", "/user/account");
          return;
        } else {
          document
            .querySelector("#profile")
            .setAttribute("href", "/user/signup");
        }
      })();

      function showsidebar() {
        document.querySelector("#sidebar").classList.remove("hidden");
      }

      function hidesidebar() {
        document.querySelector("#sidebar").classList.add("hidden");
      }
    </script>
  </body>
</html>
