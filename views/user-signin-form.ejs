<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drip Attire</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/stylesheets/output.css" />
  </head>

  <body class="flex h-screen items-center justify-center bg-Authform-bgwhite">
    <!-- Global Preloader -->
    <div class="fixed inset-0 z-[9999] flex items-center justify-center bg-white/75 backdrop-blur-md transition-all duration-300" id="global-preloader">
      <div class="h-8 w-8 animate-spin rounded-full border-[2.5px] border-solid border-[#5533ea]/10 border-t-[#5533ea] border-r-[#5533ea]"></div>
    </div>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const loader = document.getElementById('global-preloader');
          if (loader) {
            loader.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              loader.classList.add('hidden');
            }, 300);
          }
        }, 150);
      });

      // Show loader on page transition (when clicking same-origin links)
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.href && !link.target && !link.hasAttribute('download')) {
          try {
            const url = new URL(link.href);
            if (url.origin === window.location.origin && 
                url.pathname !== window.location.pathname && 
                !link.href.startsWith('javascript:') && 
                !link.href.includes('#')) {
              const loader = document.getElementById('global-preloader');
              if (loader) {
                loader.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
              }
            }
          } catch (err) {
            // Ignore invalid URLs
          }
        }
      });
    </script>

    <form
      id="userSigninForm"
      class="flex max-h-[50%] w-[80%] flex-col items-center gap-y-1 rounded-lg border bg-white font-geist sm:w-[50%] md:w-[40%] lg:w-[27%]"
    >
      <p class="mb-1 mt-4 text-center font-bold">
        Welcome to,&nbsp;&nbsp;<a class="text-2xl font-bold underline" href="/"
          >DRIP ATTIRE.</a
        >
      </p>

      <label class="mt-1 w-full indent-6" for="signup-email">Email</label>
      <input
        class="h-[35px] w-[90%] rounded-md border px-2 outline-none transition duration-200 focus:border-black focus:ring-1 focus:ring-black/40"
        type="email"
        name="emailid"
        id="signup-email"
        placeholder="Email"
      />

      <label class="mt-1 w-full indent-6" for="signup-password">Password</label>
      <input
        class="h-[35px] w-[90%] rounded-md border px-2 outline-none transition duration-200 focus:border-black focus:ring-1 focus:ring-black/40"
        type="password"
        name="password"
        id="signup-password"
        placeholder="Password"
      />

      <button
        class="mb-2 mt-3 h-[50px] w-[90%] rounded-full border bg-Authform-button font-bold text-white"
        type="submit"
      >
        Signin
      </button>

      <p class="text-[15px]">
        Are you an Admin?&nbsp;<a
          class="text-red-800 underline"
          href="/admin/signin"
          >Admin-Signin</a
        >
      </p>
      <p class="mb-3 text-[15px]">
        Don't have an account?&nbsp;<a
          class="text-red-800 underline"
          href="/user/signup"
          >Signup</a
        >
      </p>
    </form>

    <script src="/javascripts/user-signin.js"></script>
  </body>
</html>
