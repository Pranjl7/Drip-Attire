<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drip Attire</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/stylesheets/output.css" />
  </head>

  <body class="flex min-h-screen flex-col font-geist">
    <%- include('partials/user-header') %>

    <main
      class="mx-auto my-[7vh] flex min-h-[50vh] w-[80%] flex-grow flex-col-reverse justify-between gap-x-4 gap-y-4 sm:w-[70%] md:w-[60%] lg:w-[70%] lg:flex-row"
    >
      <!-- CART SECTION -->
      <div class="flex w-full flex-col rounded-md border lg:min-w-[65%]">
        <div class="mb-5 mt-4 flex items-center justify-between">
          <h1 class="indent-4 text-[25px] font-semibold">Cart</h1>
          <button
            id="clearcart"
            class="mr-4 hidden rounded-md bg-gray-950 px-5 py-1.5 text-white"
          >
            Clear
          </button>
        </div>

        <!-- SIGNIN MESSAGE -->
        <div
          id="msg-box"
          class="mb-5 mt-10 hidden flex-col items-center justify-center"
        >
          <div class="flex items-center gap-x-2">
            <h1 id="cart-msg" class="text-2xl font-medium"></h1>
            <img class="size-10" src="/assets/emptycart.svg" alt="" />
          </div>
          <a href="/user/signin">
            <button class="mt-2 rounded-md bg-gray-950 px-5 py-2 text-white">
              Sign in
            </button>
          </a>
        </div>

        <!-- EMPTY CART -->
        <div
          id="empty-cart"
          class="mb-5 mt-10 hidden flex-col items-center justify-center"
        >
          <div class="flex items-center gap-x-2">
            <h1 class="text-2xl font-medium">Cart is Empty!</h1>
            <img class="size-10" src="/assets/emptycart.svg" alt="" />
          </div>
          <a href="/collection">
            <button class="mt-2 rounded-md bg-gray-950 px-5 py-2 text-white">
              Browse Collection
            </button>
          </a>
        </div>

        <!-- CART ITEMS BLOCK -->
        <div id="cart-block" class="hidden flex-col">
          <!-- CART ITEM TEMPLATE -->
          <div
            id="cart-item"
            class="mx-auto mb-6 hidden h-[23vh] w-[95%] justify-between"
          >
            <div class="flex gap-x-2.5">
              <div
                class="img-box max-h-[80%] w-[15vh] overflow-hidden rounded-lg sm:max-h-[100%] sm:w-[20vh]"
              >
                <img
                  id="cart-image"
                  class="h-full w-full rounded-lg bg-cover bg-center"
                />
              </div>

              <div class="flex h-full max-w-[25vw] flex-col justify-between">
                <div class="flex flex-col gap-y-1">
                  <p id="cart-desc" class="text-[17px] font-semibold"></p>
                  <p id="cart-name" class="hidden text-[16px] sm:block"></p>
                  <p id="cart-size" class="hidden text-[16px] sm:block">
                    Size : S
                  </p>
                </div>

                <div class="flex gap-x-5">
                  <button class="heart-btn">
                    <img
                      class="hidden size-[22px] sm:block"
                      src="/assets/Lheart.svg"
                      alt=""
                    />
                  </button>

                  <button class="delete-btn">
                    <img class="size-[22px]" src="/assets/delete.svg" alt="" />
                  </button>
                </div>
              </div>
            </div>

            <div class="flex max-w-[15%] flex-col gap-y-2.5">
              <p id="cart-price" class="font-semibold"></p>

              <div class="flex items-center justify-end gap-x-3">
                <button class="minus-btn">
                  <img class="h-4 w-4" src="/assets/minus.svg" alt="" />
                </button>

                <p id="cart-qty" class="font-semibold"></p>

                <button class="plus-btn">
                  <img class="h-4 w-4" src="/assets/plus.svg" alt="" />
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ORDER SUMMARY -->
      <div class="w-full lg:min-w-[32%]">
        <div class="min-h-[25vh] rounded-md border">
          <div class="mx-auto my-4 flex w-[90%] flex-col gap-y-2">
            <h1 class="mb-2 text-2xl font-semibold">Order Summary</h1>

            <div class="flex justify-between">
              <p>Subtotal</p>
              <p id="subtotal" class="font-semibold">₹0.00</p>
            </div>

            <div class="mb-1 flex justify-between">
              <p>Delivery</p>
              <p id="delivery" class="font-semibold">₹0.00</p>
            </div>

            <hr />

            <div class="mt-1 flex justify-between">
              <p class="text-[19px] font-medium">Total</p>
              <p id="total" class="font-semibold">₹0.00</p>
            </div>

            <a id="checkout-btn" class="hidden w-full" href="/checkout">
              <button
                class="mt-2 w-full rounded-md bg-gray-950 py-2.5 text-white"
              >
                Checkout
              </button>
            </a>
          </div>
        </div>
      </div>
    </main>

    <script src="/javascripts/cart.js"></script>
    <%- include('partials/footer') %>
  </body>
</html>
