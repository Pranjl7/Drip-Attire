<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drip Attire</title>
    <link rel="stylesheet" href="/stylesheets/output.css" />
  </head>

  <body class="relative font-geist">
    <!-- Global Preloader -->
    <div class="fixed inset-0 z-[9999] flex items-center justify-center bg-white/75 backdrop-blur-md transition-all duration-300" id="global-preloader">
      <div class="h-8 w-8 animate-spin rounded-full border-[2.5px] border-solid border-[#5533ea]/10 border-t-[#5533ea] border-r-[#5533ea]"></div>
    </div>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const loader = document.getElementById('global-preloader');
          if (loader) {
            loader.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              loader.classList.add('hidden');
            }, 300);
          }
        }, 150);
      });

      // Show loader on page transition (when clicking same-origin links)
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.href && !link.target && !link.hasAttribute('download')) {
          try {
            const url = new URL(link.href);
            if (url.origin === window.location.origin && 
                url.pathname !== window.location.pathname && 
                !link.href.startsWith('javascript:') && 
                !link.href.includes('#')) {
              const loader = document.getElementById('global-preloader');
              if (loader) {
                loader.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
              }
            }
          } catch (err) {
            // Ignore invalid URLs
          }
        }
      });
    </script>

    <nav class="mx-auto flex w-[95vw] items-center justify-between pt-4">
      <!-- HAMBURGER ICON -->
      <button onclick="showsidebar()" class="ml-2 lg:hidden">
        <img class="size-5 sm:size-6" src="/assets/DMenu.svg" alt="" />
      </button>

      <!-- SIDEBAR -->
      <div
        id="sidebar"
        class="absolute left-0 top-0 z-10 hidden h-full w-60 bg-white transition duration-200"
      >
        <button onclick="hidesidebar()" class="absolute right-1.5 top-1.5">
          <img class="size-8" src="/assets/xmark.svg" alt="" />
        </button>
        <div class="flex flex-col gap-y-7 pl-4 pt-12">
          <a href="/" class="text-xl">HOME</a>
          <a href="/collection" class="text-xl">COLLECTION</a>
          <a href="/collection" class="text-xl">NEW ARRIVALS</a>
          <a href="/refundpolicy" class="text-xl">REFUND POLICY</a>
          <a href="/terms-and-conditions" class="text-xl">TERMS & CONDITIONS</a>
        </div>
      </div>

      <!-- LOGO TEXT -->
      <a
        class="cursor-pointer pl-8 text-3xl font-semibold lg:hidden"
        href="/admin/account"
      >
        <p>DRIP ATTIRE.</p>
      </a>

      <div
        class="hidden cursor-pointer items-center justify-around gap-x-5 font-geist text-sm text-black lg:flex"
      >
        <a class="transition duration-150 hover:text-[#a09b9b]" href="/"
          >HOME</a
        >
        <a
          class="transition duration-150 hover:text-[#a09b9b]"
          href="/collection"
          >COLLECTION</a
        >
        <a
          class="transition duration-150 hover:text-[#a09b9b]"
          href="/collection"
          >NEW ARRIVALS</a
        >
        <a
          class="transition duration-150 hover:text-[#a09b9b]"
          href="/refundpolicy"
          >REFUND POLICY</a
        >
        <a
          class="transition duration-150 hover:text-[#a09b9b]"
          href="/terms-and-conditions"
          >TERMS & CONDITIONS</a
        >
        <a
          class="cursor-pointer pl-8 text-3xl font-semibold"
          href="/admin/account"
        >
          <p>DRIP ATTIRE.</p>
        </a>
      </div>

      <!-- 0-SM BUTTON -->
      <button
        onclick="logout()"
        class="mr-2 flex items-center justify-center sm:hidden"
      >
        <img class="size-6" src="/assets/logout.svg" alt="" />
      </button>

      <!-- SM-LG-* -->
      <button
        onclick="logout()"
        class="mr-2 hidden items-center justify-center rounded-full bg-slate-900 px-6 py-3 font-semibold text-white sm:flex"
      >
        Log Out
      </button>
    </nav>

    <script>
      async function logout() {
        let confirmed = confirm("Confirm Logout?");
        if (!confirmed) return;

        let res = await fetch("/api/admin/logout", {
          method: "DELETE",
        });

        let data = await res.json();
        if (res.ok) {
          window.location.href = "/";
        } else {
          alert(data.message);
        }
      }

      function showsidebar() {
        document.querySelector("#sidebar").classList.remove("hidden");
      }

      function hidesidebar() {
        document.querySelector("#sidebar").classList.add("hidden");
      }
    </script>
  </body>
</html>
